DATABASE_URL="postgresql://project_visibility:project_visibility_dev@localhost:5432/project_visibility?schema=public"

# Admin auth (seeded via `npm run seed`)
NEXTAUTH_SECRET="generate-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# OpenAI — powers audit scoring/narrative, outreach drafts, reply drafts. Leave blank to see
# the explicit "not connected" behavior rather than any fabricated output.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Google Places API — public business data for auditing PROSPECTS (no OAuth needed).
GOOGLE_PLACES_API_KEY=""

# SERP data provider — defaults to SerpAPI, swappable via lib/providers/serp.ts
SERP_API_KEY=""

# Stripe — test mode only for V1
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_FOUNDING=""

# Resend — transactional email for approved outreach + audit report delivery
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# V2: encrypts Google OAuth refresh tokens at rest (lib/crypto.ts). Local secret, not a
# third-party credential — generate with `openssl rand -base64 32`.
ENCRYPTION_KEY="generate-a-random-32-byte-secret-base64"

# V2: "Sign in with Google" for customers + Business Profile API access. See INFRASTRUCTURE.md
# for how to create this OAuth client. Until set, /portal/login shows an explicit
# "not configured" state rather than a broken button.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
